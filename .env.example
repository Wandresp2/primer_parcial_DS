# Credenciales de MySQL
# Nota: MYSQL_USER no puede ser "root"; para root usa solo MYSQL_ROOT_PASSWORD.
MYSQL_ROOT_PASSWORD=root
# Nombre de la base del proyecto. sql/schema.sql la CREA (CREATE DATABASE).
# Los notebooks se conectan a esta base; no uses db_prueba.
MYSQL_DATABASE=optica_y_fotonica

# Token de inicio de sesión para Jupyter
JUPYTER_TOKEN=facil123
