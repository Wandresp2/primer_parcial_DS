FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-pipeline.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-pipeline.txt

# El código se monta en runtime (compose volumes: ./:/app).
# CMD por defecto = pipeline completo; se puede override:
#   docker compose --profile pipeline run --rm --entrypoint python pipeline scripts/04_etl_mysql.py
# sed quita CRLF por si el volumen se monta desde Windows.
CMD ["bash", "-c", "sed -i 's/\\r$//' scripts/run_pipeline.sh && bash scripts/run_pipeline.sh"]